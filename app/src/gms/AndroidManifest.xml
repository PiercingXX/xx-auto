<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 9, AU12, `gms` flavor only. This manifest merges into the main one
     for the opt-in `gms` build variant; the default `noGms` variant never sees
     it, so the Google-free build carries no androidx.car.app at all. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Android Auto discovers templated apps through this descriptor. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <!-- Car API level 1 is enough: ListTemplate + ActionStrip + Row clicks. -->
        <meta-data
            android:name="androidx.car.app.minCarVersion"
            android:value="1" />

        <!-- The Android Auto entry point. The host instantiates this
             CarAppService from this declaration — manifest registration IS the
             wiring. Media category only (AU12): xx-auto renders a templated
             media surface and hands navigation off to xx-maps; it never
             declares category.NAVIGATION and never draws a map. -->
        <service
            android:name=".car.AutoCarAppService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.MEDIA" />
            </intent-filter>
        </service>
    </application>

</manifest>
