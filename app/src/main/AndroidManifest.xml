<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- AU11: NO INTERNET. Nothing leaves the phone. The merged release
         manifest is audited against this list by scripts/check-permissions.sh. -->

    <!-- Auto-launch (AU2): pick a bonded Bluetooth device and hear its ACL
         connect / disconnect. API 31+ gates both behind BLUETOOTH_CONNECT
         (runtime, asked when the toggle is switched on); API 26-30 gates them
         behind the install-time BLUETOOTH permission. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <!-- Auto-launch overlay exemption (AU2): holding SYSTEM_ALERT_WINDOW lets
         the receiver start the drive screen from the background on API 29-35.
         xx-auto never draws an overlay; the permission is only the exemption. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Auto-launch fallback (AU2): when the overlay grant is refused, the
         receiver posts one "Car connected — open xx-auto" notification.
         Requested only on that path, the first time. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Calls surface (AU8): asked only when surface_calls is switched on.
         Denied CALL_PHONE falls back to ACTION_DIAL. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- media3-common adds ACCESS_NETWORK_STATE for ExoPlayer's network-type
         detection. xx-auto is a MediaController with no player and no network
         (AU4, AU11), so it is stripped from the merged manifest. -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />
    <!-- WAKE_LOCK is deliberately absent (design "Identity and build"):
         keep-screen-on is a window flag, and the receiver uses goAsync(). -->

    <!-- Family theme-sync. xx-launcher defines and sendBroadcast()s with this
         signature permission; uses-permission is required to receive it. -->
    <uses-permission android:name="com.piercingxx.xxlauncher.permission.THEME_SYNC" />

    <!-- CALL_PHONE and BLUETOOTH would otherwise imply both features are
         required; a phone without either still gets the drive screen. -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />

    <!-- Package visibility (targetSdk 35). Without these, getServiceInfo()
         on the suite players throws NameNotFound and nothing ever connects,
         and resolveActivity() never finds xx-maps. Named packages only (AU6:
         found by component, not by scanning). -->
    <queries>
        <package android:name="${applicationId}" />
        <!-- AU6 suite players -->
        <package android:name="com.skpp.radio" />
        <package android:name="com.piercingxx.audiobook" />
        <!-- AU7 Maps tile, and the xx-apps listing for the not-installed state -->
        <package android:name="com.piercingxx.maps" />
        <package android:name="com.piercingxx.apps" />
    </queries>

    <application
        android:name=".XxAutoApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.XxAuto">

        <!-- The drive screen. singleTask: exactly one instance; the auto-launch
             receiver (AU2) reuses it rather than stacking a second. configChanges
             left default — Compose handles rotation (AU9 follow_rotation). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Suite backup door; contract: xx-apps/docs/SUITE-BACKUP-PROVIDER.md.
             xx-apps declares com.piercingxx.suite.permission.BACKUP; this app
             only references it. AutoBackupProvider is the concrete subclass and
             the real door at ${applicationId}.suite.backup.

             The vendored base SuiteBackupProvider is deliberately NOT declared
             here: it is abstract, and Android instantiates every manifest
             <provider> at process start before Application.onCreate — an
             abstract class cannot be instantiated and would crash the app with
             InstantiationException. Its own KDoc says "never a manifest
             component": each suite app declares only its concrete subclass. -->
        <provider
            android:name=".backup.AutoBackupProvider"
            android:authorities="${applicationId}.suite.backup"
            android:exported="true"
            android:permission="com.piercingxx.suite.permission.BACKUP" />

        <!-- Suite log dump door; xx-apps reads this app's log ring buffer. -->
        <provider
            android:name=".log.LogDumpProvider"
            android:authorities="${applicationId}.logs"
            android:exported="true"
            android:permission="com.piercingxx.apps.permission.READ_SUITE_LOGS" />

        <!-- Launcher-only theme sync. The family launcher (xx-launcher) sends
             THEME_CHANGED guarded by this signature permission; we receive it
             and persist the synced ground through ThemeStore. -->
        <receiver
            android:name=".ui.theme.ThemeSyncReceiver"
            android:exported="true"
            android:permission="com.piercingxx.xxlauncher.permission.THEME_SYNC">
            <intent-filter>
                <action android:name="xx.launcher.THEME_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Auto-launch trigger (AU2): registered disabled; AutoPrefs enables it
             only while the auto_launch toggle is on, so it never wakes for a
             connection the user has not opted into. -->
        <receiver
            android:name=".trigger.CarConnectReceiver"
            android:exported="true"
            android:enabled="false">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
